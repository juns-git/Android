<?xml version="1.0" encoding="utf-8"?>
<!--
    FSG 앱 아이콘 포그라운드
    Safe zone: 108×108 canvas 중 중앙 72dp (x:18-90, y:18-90)
    레이어 순서: 집 윤곽 → 자녀 배지 → 황금 화살표 → 화살표 헤드
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        집(House/Gate) 실루엣 테두리
        Peak(54,22) → LeftEaveOut(14,52) → LeftWall(21,52→84)
        → DoorLeft(41,84→66) → DoorTop(41→67,66) → DoorRight(67,66→84)
        → RightWall(87,84→52) → RightEaveOut(94,52) → close
    -->
    <path
        android:pathData="M54,22 L14,52 L21,52 L21,84 L41,84 L41,66 L67,66 L67,84 L87,84 L87,52 L94,52 Z"
        android:fillColor="#00000000"
        android:strokeColor="#E2E8F0"
        android:strokeWidth="3.2"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!--
        아들 배지 — 하늘색 원 (좌측 베이 center 31,65 r=8)
        좌측 베이 = 집 벽(x:21) ~ 문 좌측(x:41) = 중앙 x=31
    -->
    <path
        android:pathData="M31,57 A8,8 0 1,0 31,73 A8,8 0 1,0 31,57 Z"
        android:fillColor="#38BDF8" />

    <!--
        딸 배지 — 연분홍 원 (우측 베이 center 77,65 r=8)
        우측 베이 = 문 우측(x:67) ~ 집 벽(x:87) = 중앙 x=77
    -->
    <path
        android:pathData="M77,57 A8,8 0 1,0 77,73 A8,8 0 1,0 77,57 Z"
        android:fillColor="#FB7185" />

    <!--
        황금 우상향 화살표 라인 (10,94) → (90,18)
        그라데이션: 황금(#F59E0B) → 에메랄드(#34D399)
    -->
    <path
        android:pathData="M10,94 L90,18"
        android:fillColor="#00000000"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="10"
                android:startY="94"
                android:endX="90"
                android:endY="18">
                <item android:offset="0.0" android:color="#FFF59E0B"/>
                <item android:offset="0.6" android:color="#FFFBBF24"/>
                <item android:offset="1.0" android:color="#FF34D399"/>
            </gradient>
        </aapt:attr>
    </path>

    <!--
        화살표 헤드 (황금색 채움)
        Direction (10,94)→(90,18): norm≈(0.725,-0.689), perp≈(0.689,0.725)
        back=(90-6.5,18+6.2)=(83.5,24.2) → 반올림 (84,24)
        left=(84+3.4,24+3.6)=(87.4,27.6) → (87,28)
        right=(84-3.4,24-3.6)=(80.6,20.4) → (81,20)
    -->
    <path
        android:pathData="M90,18 L87,28 L81,20 Z"
        android:fillColor="#FBBF24" />

    <!--
        에메랄드 액센트 도트 — 화살표와 집 처마 교차 지점 (54,52) 부근
        화살표 x=54 에서 y = 94+(18-94)*(54-10)/(90-10) = 94-76*0.55 ≈ 52
    -->
    <path
        android:pathData="M54,48.5 A3.5,3.5 0 1,0 54,55.5 A3.5,3.5 0 1,0 54,48.5 Z"
        android:fillColor="#34D399" />

</vector>
